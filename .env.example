# --- Core ---------------------------------------------------------------
DATABASE_URL=sqlite:///./quiz.db
# Session-cookie signing key. Generate: python -c "import secrets;print(secrets.token_hex(32))"
SECRET_KEY=change-me-generate-a-random-64-char-hex
# Public host used to build absolute URLs (result links in emails).
APP_HOST=quiz.agentic-reach.com

# --- Admin (single-password admin area) ---------------------------------
ADMIN_PASSWORD=change-me

# --- Lead pipeline: vibe CRM push ---------------------------------------
# Leave CRM_INGEST_URL empty to skip the CRM leg (local dev).
CRM_INGEST_URL=https://vibe.agentic-reach.com/api/leads
CRM_API_KEY=change-me

# --- Score levels: traffic-light thresholds (red / orange / green) ------
# Applied to any 0-100 score (overall + each dimension): below MID => red,
# below HIGH => orange, at/above HIGH => green.
SCORE_THRESHOLD_MID=40
SCORE_THRESHOLD_HIGH=70

# --- Lead pipeline: SMTP email ------------------------------------------
# Leave SMTP_HOST empty to skip the email leg (local dev).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=quiz@agentic-reach.com
SMTP_STARTTLS=true
